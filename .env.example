# Base de datos
POSTGRES_USER=fargoz
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=fargoz

# Inicio de sesión (obligatorio: sin ADMIN_PASSWORD nadie puede entrar)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia_esta_contrasena
# Cadena larga y aleatoria. Genera una con:  openssl rand -hex 32
JWT_SECRET=
TOKEN_HOURS=12
# Ponlo en true cuando sirvas la web por HTTPS
COOKIE_SECURE=false

# Asistente conversacional. Elige el proveedor: gemini (tiene nivel gratuito) o claude.
LLM_PROVIDER=gemini
# Clave gratuita en https://aistudio.google.com (inicia sesión con tu cuenta de Google)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Modelo alternativo si el principal está saturado (503) o sin cupo (429). Déjalo vacío para no usar alternativo.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Tiempo máximo de espera por consulta y nivel de razonamiento (minimal, low, medium, high). «low» responde más rápido.
GEMINI_TIMEOUT_SECONDS=30
GEMINI_THINKING_LEVEL=low
# Solo si usas LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# «production» oculta /docs y /openapi.json de la API. Úsalo al publicarla en internet.
ENVIRONMENT=development

# Seguridad: tamaño máximo (MB) de un Excel/CSV importado, y consultas a la IA permitidas cada 10 minutos.
MAX_UPLOAD_MB=10
AI_CHAT_PER_10MIN=30
AI_ANALYSIS_PER_10MIN=12

# Origen permitido del frontend (solo si llamas a la API directamente desde el navegador)
CORS_ORIGINS=http://localhost:3000
